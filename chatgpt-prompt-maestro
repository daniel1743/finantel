## Cómo Usar este Prompt

### 1. **Copiar el Prompt Completo**
```javascript
const SYSTEM_PROMPT = `[COPIA TODO LO DE ARRIBA]`;
```

### 2. **Configurar OpenAI Client**
```javascript
import OpenAI from "openai";

const client = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY,
});

async function processExpense(userExpenseText) {
  const response = await client.chat.completions.create({
    model: "gpt-4-turbo",
    messages: [
      {
        role: "system",
        content: SYSTEM_PROMPT
      },
      {
        role: "user",
        content: userExpenseText
      }
    ],
    temperature: 0.2, // Bajo para respuestas consistentes
    max_tokens: 500,
    response_format: {
      type: "json_object"
    }
  });

  try {
    return JSON.parse(response.choices[0].message.content);
  } catch (error) {
    console.error("Invalid JSON from ChatGPT:", error);
    return { status: "error", message: "Invalid response" };
  }
}

// Uso:
const result = await processExpense("Gasté 28 mil en zapatos");
console.log(result);
```

### 3. **Guardar en Base de Datos**
```javascript
async function saveExpense(userId, expenseData) {
  const { data, error } = await supabase
    .from("user_expenses")
    .insert({
      user_id: userId,
      product_id: expenseData.product?.id,
      product_name: expenseData.product?.name,
      amount: expenseData.expense.amount,
      category: expenseData.product?.categoryId,
      expense_date: new Date().toISOString(),
      voice_note: expenseData.metadata.originalText,
      parsed_by_ai: expenseData.recognized,
      ai_confidence: expenseData.classification.confidence,
      notes: expenseData.insights?.recommendation
    });

  if (error) {
    console.error("Database error:", error);
  }
  return data;
}
```

