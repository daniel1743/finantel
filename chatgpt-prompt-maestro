// Cache de productos para búsqueda rápida
const productCache = new Map();
database.products.forEach(p => {
  productCache.set(p.id, p);
  p.keywords.forEach(k => {
    if (!productCache.has(k)) {
      productCache.set(k, []);
    }
    productCache.get(k).push(p);
  });
});

// Búsqueda rápida
function findProduct(keyword) {
  return productCache.get(keyword.toLowerCase());
}
```

